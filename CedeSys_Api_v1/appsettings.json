{

  // esta parte controla que los mensajes se muestren el log 
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },


  // definimos los nombres de la cookies para despues usarlo en cookieservice
  "Cookie": {
    "AccessCookieName": "access_token",
    "RefreshCookieName": "refresh_token"
  },


  //cors indica que dominio puede consumir la api desde el navegador 
  "Cors": {
    "AllowedOrigins": []
  },


  // implementacion de limite de peticiones por minuto 
  "RateLimit": {
    "PermitPerMinute": 10,
    "WindowMinutes": 5,
    "QueueLimit": 2
  },


  //En producción suele dejarse así si la aplicación está detrás de un proxy inverso como NGINX.
  "AllowedHosts": "*",


  //Aceptar conexiones desde cualquier IP y se redirige al puerto
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": ""
      }
    }
  },


  // implementacion de JWT
  "Jwt": {
    "Key": "",
    "Issuer": "ApiCedSystem",
    "Audience": "CedSystemApp",

    "AccessTokenMinutes": 180,
    "RefreshTokenDays": 15
  },

  // coneccion a la base de datos
  "ConnectionStrings": {
    "SqlServerConnection": ""
  },


  // bloqueo de autenticacion especifica 
  "Authentication": {
    "MaxFailedAttemptsPerEmail": 5,
    "MaxFailedAttemptsPerIp": 20,
    "BlockMinutesEmail": 30,
    "BlockMinutesIp": 40
  }
}
